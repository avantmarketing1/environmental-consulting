{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "fieldtoforest-consulting",
	"main": "src/index.ts",
	"compatibility_date": "2026-11-22",
	"compatibility_flags": [
		"nodejs_compat"
	],
	"observability": {
		"enabled": true,
		"traces": {
			"enabled": true
		}
	},
	"assets": {
		"directory": "./public",
		"binding": "ASSETS",
		"html_handling": "auto-trailing-slash",
		"not_found_handling": "none",
		"run_worker_first": [
			"/consulting/app*",
			"/consulting/py/*",
			"/consulting/api/*",
			"/consulting/admin-login"
		]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "fieldtoforest-consulting-db",
			"database_id": "9dc54e9c-b354-4916-baa3-9a4ebc8d6f8f",
			"migrations_dir": "migrations"
		},
		{
			"binding": "fieldtoforest_consulting_db",
			"database_name": "fieldtoforest-consulting-db",
			"database_id": "9dc54e9c-b354-4916-baa3-9a4ebc8d6f8f",
			"remote": true
		}
	],
	"r2_buckets": [
		{
			"binding": "FILES",
			"bucket_name": "fieldtoforest-consulting-files"
		},
		{
			"bucket_name": "fieldtoforest-consulting-files",
			"binding": "fieldtoforest_consulting_files",
			"remote": true
		}
	],
	"vars": {
		"BRAND_NAME": "Field To Forest",
		"SITE_URL": "https://fieldtoforestfarm.com",
		"BASE_PATH": "/consulting",
		"DEFAULT_LGA": "Lismore City Council",
		"GEMINI_MODEL": "gemini-4-hydrogen"
	},
	// Uncomment after creating your D1 database ID and connecting your Cloudflare zone:
	"workers_dev": false,
	"routes": [
		{
			"pattern": "fieldtoforestfarm.com/consulting*",
			"zone_name": "fieldtoforestfarm.com"
		}
	]
}